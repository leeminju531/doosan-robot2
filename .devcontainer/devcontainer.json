// See https://aka.ms/vscode-remote/devcontainer.json for format details.
{
	"dockerFile": "Dockerfile",
	"build": {
		"args": {
			"WORKSPACE": "${containerWorkspaceFolder}",
			// "USER_UID": "$(id -u)",
			// "USER_GID": "$(id -g)",
			// "DOCKER_GID": "$(getent group docker | cut -d: -f3)"
			"USER_UID": "${localEnv:USER_UID}",
			"USER_GID": "${localEnv:USER_GID}",
			"DOCKER_GID": "${localEnv:DOCKER_GID}"
		}
	},
	"remoteUser": "doosan-robotics",
	"workspaceFolder": "/workspace/doosan_ws/src/doosan-robot2",
	"workspaceMount": "source=${localWorkspaceFolder},target=${containerWorkspaceFolder},type=bind",
	"postCreateCommand": ".devcontainer/post-command.sh",
	"runArgs": [
		"--network=host",
		"--cap-add=SYS_PTRACE",
		"--security-opt=seccomp:unconfined",
		"--security-opt=apparmor:unconfined",
		"--volume=/tmp/.X11-unix:/tmp/.X11-unix",
		"--volume=/var/run/docker.sock:/var/run/docker.sock", // Docker in docker for emulator
		// we don't need to take care uid binding. 
		// https://github.com/microsoft/vscode-remote-release/issues/4946#issuecomment-1348583560
		"--volume=/run/user:/run/user",
		// "--volume=/mnt/wslg:/mnt/wslg",
		"--ipc=host",
		// uncomment to use intel iGPU
		// "--device=/dev/dri"

		// For core dump unlimited
		"--ulimit=core=-1",
		// For core dump file.
		// I assumed that kernel.core_pattern=/tmp/core.%e.%p in /etc/sysctl.conf
		// (check "cat /proc/sys/kernel/core_pattern")
		"--volume=/tmp:/tmp" 
	],
	"containerEnv": {
		"DISPLAY": "${localEnv:DISPLAY}", // Needed for GUI try ":0" for windows
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
		"XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
		"PULSE_SERVER": "${localEnv:PULSE_SERVER}",
		"LIBGL_ALWAYS_SOFTWARE": "1" // Needed for software rendering of opengl
	},
	// Set *default* container specific settings.json values on container create.
	"customizations": {
		"vscode": {
			"extensions": [
				"althack.ament-task-provider",
				"betwo.b2-catkin-tools",
				"DotJoshJohnson.xml",
				"ms-azuretools.vscode-docker",
				"ms-iot.vscode-ros",
				"ms-python.python",
				"ms-vscode.cpptools",
				"redhat.vscode-yaml",
				"smilerobotics.urdf",
				"streetsidesoftware.code-spell-checker",
				"twxs.cmake",
				"yzhang.markdown-all-in-one",
				"zachflower.uncrustify"
			]
		}
	}
}
